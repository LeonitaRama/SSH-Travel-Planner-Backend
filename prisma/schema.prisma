generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique
  createdAt     DateTime        @default(now())
  settings      TenantSettings?
  users         User[]
  refreshTokens RefreshToken[]

  destinations   Destination[]
  hotels         Hotel[]
  rooms          Room[]
  flights        Flight[]
  bookings       Booking[]
  bookingItems   BookingItem[]
  payments       Payment[]
  auditLogs      AuditLog[]
  reviews        Review[]
  notifications  Notification[]
  travelPackages TravelPackage[]
  airlines       Airline[]
  airports       Airport[]
  activities     Activity[]
  wishlists      Wishlist[]
  aiChats        AiChat[]
}

model TenantSettings {
  id       String  @id @default(uuid())
  tenantId String  @unique
  theme    String?
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(uuid())
  email     String
  username  String?
  password  String
  tenantId  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  bookings      Booking[]
  auditLogs     AuditLog[]
  reviews       Review[]
  wishlists     Wishlist[]
  aiChats       AiChat[]

  @@unique([email, tenantId])
  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([token])
  @@index([expiresAt])
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

model Destination {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  country     String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotels         Hotel[]
  bookings       Booking[]
  reviews        Review[]
  travelPackages TravelPackage[]
  activities     Activity[]
  wishlists      Wishlist[]

  @@index([tenantId])
}

model Hotel {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  description   String
  address       String
  rating        Float?
  pricePerNight Float
  imageUrl      String?
  destinationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms Room[]

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  reviews     Review[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([destinationId])
}

model Room {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Float
  capacity    Int
  imageUrl    String?
  tenantId    String
  hotelId     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotel  Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Flight {
  id            String    @id @default(uuid())
  tenantId      String
  flightNumber  String
  airline       String
  departureCity String
  arrivalCity   String
  price         Float
  departureTime DateTime?
  arrivalTime   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model Booking {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  destinationId  String
  hotelId        String?
  roomId         String?
  flightId       String?
  numberOfGuests Int
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])
  hotel       Hotel?      @relation(fields: [hotelId], references: [id])
  room        Room?       @relation(fields: [roomId], references: [id])
  flight      Flight?     @relation(fields: [flightId], references: [id])

  bookingItems BookingItem[]
  payments     Payment[]
}

model BookingItem {
  id          String   @id @default(uuid())
  tenantId    String
  bookingId   String
  type        String
  referenceId String
  price       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(uuid())
  amount    Float
  currency  String
  status    String
  tenantId  String
  bookingId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  message   String
  status    String?
  tenantId  String
  userId    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model Review {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String
  hotelId       String?
  destinationId String?
  rating        Int
  comment       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel       Hotel?       @relation(fields: [hotelId], references: [id])
  destination Destination? @relation(fields: [destinationId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TravelPackage {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  price         Float
  duration      Int
  imageUrl      String?
  destinationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([destinationId])
}

model Airline {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String // p.sh., "LH" për Lufthansa, "TK" për Turkish Airlines
  country   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Airport {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String // IATA code, p.sh., "PRN", "TIA", "JFK"
  city      String
  country   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Activity {
  id            String   @id @default(uuid())
  tenantId      String
  destinationId String
  name          String
  description   String
  price         Float
  duration      String // p.sh., "2 hours", "Full day"
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([destinationId])
}

model Wishlist {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String
  destinationId String
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([tenantId])
  @@index([userId])
}

model AiChat {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  prompt    String
  response  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}
