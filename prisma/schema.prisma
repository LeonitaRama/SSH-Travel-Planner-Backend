generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique // E lëmë për public URL, por jo për header
  createdAt     DateTime        @default(now())
  settings      TenantSettings?
  users         User[]
  refreshTokens RefreshToken[]
}

model TenantSettings {
  id       String  @id @default(uuid())
  tenantId String  @unique
  theme    String?
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id            String   @id @default(uuid())
  email         String
  username      String?
  password      String
  tenantId      String
  role          Role     @default(CUSTOMER)  // ← Default CUSTOMER
  createdAt     DateTime @default(now())
  
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  
  @@unique([email, tenantId])
  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([token])
  @@index([expiresAt])
}

enum Role {
  CUSTOMER     // Klient i zakonshëm - mund të rezervojë
  STAFF        // Staf - mund të menaxhojë rezervimet
  ADMIN        // Admin - mund të menaxhojë agjencinë
  SUPER_ADMIN  // Super Admin - mund të menaxhojë të gjitha agjencitë
}