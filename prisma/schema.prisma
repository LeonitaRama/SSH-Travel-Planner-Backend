generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique // E lëmë për public URL, por jo për header
  createdAt     DateTime        @default(now())
  settings      TenantSettings?
  users         User[]
  refreshTokens RefreshToken[]

  destinations Destination[]
  hotels       Hotel[]
  rooms        Room[]
  flights      Flight[]
  bookings     Booking[]
  bookingItems BookingItem[]
  payments     Payment[]
  auditLogs    AuditLog[]
  reviews      Review[]
}

model TenantSettings {
  id       String  @id @default(uuid())
  tenantId String  @unique
  theme    String?
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id        String   @id @default(uuid())
  email     String
  username  String?
  password  String
  tenantId  String
  role      Role     @default(CUSTOMER) // ← Default CUSTOMER
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  bookings      Booking[]
  auditLogs     AuditLog[]
  reviews       Review[]

  @@unique([email, tenantId])
  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([token])
  @@index([expiresAt])
}

enum Role {
  CUSTOMER // Klient i zakonshëm - mund të rezervojë
  STAFF // Staf - mund të menaxhojë rezervimet
  ADMIN // Admin - mund të menaxhojë agjencinë
  SUPER_ADMIN // Super Admin - mund të menaxhojë të gjitha agjencitë
}

model Destination {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  country     String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotels   Hotel[]
  bookings Booking[]
  reviews  Review[]

  @@index([tenantId])
}

model Hotel {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  description   String
  address       String
  rating        Float?
  pricePerNight Float
  imageUrl      String?
  destinationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms Room[]

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  reviews     Review[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([destinationId])
}

model Room {
  id String @id @default(uuid())

  name        String
  description String?
  price       Float
  capacity    Int
  imageUrl    String?

  tenantId String
  hotelId  String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotel  Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Flight {
  id String @id @default(uuid())

  tenantId String

  flightNumber String
  airline      String

  departureCity String
  arrivalCity   String

  price Float

  departureTime DateTime?
  arrivalTime   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model Booking {
  id String @id @default(uuid())

  tenantId String
  userId   String

  destinationId String
  hotelId       String?
  roomId        String?
  flightId      String?

  numberOfGuests Int

  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  destination Destination @relation(fields: [destinationId], references: [id])
  hotel       Hotel?      @relation(fields: [hotelId], references: [id])
  room        Room?       @relation(fields: [roomId], references: [id])
  flight      Flight?     @relation(fields: [flightId], references: [id])

  bookingItems BookingItem[]
  payments     Payment[]
}

model BookingItem {
  id String @id @default(uuid())

  tenantId  String
  bookingId String

  type        String
  referenceId String
  price       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id       String @id @default(uuid())
  amount   Float
  currency String
  status   String

  tenantId  String
  bookingId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id      String  @id @default(uuid())
  action  String
  message String
  status  String?

  tenantId String
  userId   String?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model Review {
  id String @id @default(uuid())

  tenantId String
  userId   String

  hotelId       String?
  destinationId String?

  rating  Int
  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  hotel Hotel? @relation(fields: [hotelId], references: [id])

  destination Destination? @relation(fields: [destinationId], references: [id])
}
