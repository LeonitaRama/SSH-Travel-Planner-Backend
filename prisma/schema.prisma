generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique // E lëmë për public URL, por jo për header
  createdAt     DateTime        @default(now())
  settings      TenantSettings?
  users         User[]
  refreshTokens RefreshToken[]
}

model TenantSettings {
  id       String  @id @default(uuid())
  tenantId String  @unique
  theme    String?
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id            String         @id @default(uuid())
  username      String?
  email         String         @unique
  password      String
  tenantId      String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings      Booking[]

  @@unique([email, tenantId]) // Lejon të njëjtin email në tenante të ndryshme, por unik brenda një tenanti
  @@index([tenantId])
}

model Destination {
  id          Int       @id @default(autoincrement())
  name        String
  country     String
  description String
  image       String?
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  hotels      Hotel[]
}

model Hotel {
  id          String   @id @default(cuid())
  name        String
  location    String
  description String?
  createdAt   DateTime @default(now())

  bookings Booking[]
}

model Flight {
  id          String    @id @default(uuid())
  from        String
  to          String
  price       Float
  departureAt DateTime
  bookings    Booking[]
}

model Booking {
  id       String   @id @default(cuid())
  userId   String
  flightId String
  hotelId  String?
  date     DateTime
  status   String?

  user   User   @relation(fields: [userId], references: [id])
  flight Flight @relation(fields: [flightId], references: [id])
  hotel  Hotel? @relation(fields: [hotelId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([token])
  @@index([expiresAt])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}
