generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique
  createdAt     DateTime        @default(now())
  settings      TenantSettings?
  users         User[]
  refreshTokens RefreshToken[]

  destinations         Destination[]
  hotels               Hotel[]
  rooms                Room[]
  flights              Flight[]
  bookings             Booking[]
  bookingItems         BookingItem[]
  payments             Payment[]
  auditLogs            AuditLog[]
  reviews              Review[]
  notifications        Notification[]
  travelPackages       TravelPackage[]
  airlines             Airline[]
  airports             Airport[]
  activities           Activity[]
  wishlists            Wishlist[]
  aiChats              AiChat[]
  coupons              Coupon[]
  bookingConfirmations BookingConfirmation[]
  emailLogs            EmailLog[]
  webhookEvents        WebhookEvent[]
}

model User {
  id        String   @id @default(uuid())
  email     String
  username  String?
  password  String
  tenantId  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  bookings      Booking[]
  auditLogs     AuditLog[]
  reviews       Review[]
  wishlists     Wishlist[]
  aiChats       AiChat[]

  @@unique([email, tenantId])
  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@index([token])
  @@index([expiresAt])
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

model Destination {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  country     String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotels         Hotel[]
  bookings       Booking[]
  reviews        Review[]
  travelPackages TravelPackage[]
  activities     Activity[]
  wishlists      Wishlist[]

  @@index([tenantId])
}

model Hotel {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  description   String
  address       String
  rating        Float?
  pricePerNight Float
  imageUrl      String?
  destinationId String 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms Room[]

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  reviews     Review[]

  travelPackages TravelPackage[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([destinationId])
}

model Room {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Float
  capacity    Int
  imageUrl    String?
  tenantId    String
  hotelId     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotel  Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Flight {
  id            String    @id @default(uuid())
  tenantId      String
  flightNumber  String
  airline       String
  departureCity String
  arrivalCity   String
  price         Float
  departureTime DateTime?
  arrivalTime   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  travelPackages TravelPackage[]
}

model Booking {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String
  destinationId  String
  hotelId        String?
  roomId         String?
  flightId       String?
  numberOfGuests Int
  startDate      DateTime
  endDate        DateTime
  status         String   @default("PENDING") // SHTOHET FUSHA E STATUSIT (PENDING, CONFIRMED, CANCELLED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id])
  hotel       Hotel?      @relation(fields: [hotelId], references: [id])
  room        Room?       @relation(fields: [roomId], references: [id])
  flight      Flight?     @relation(fields: [flightId], references: [id])

  bookingItems        BookingItem[]
  payments            Payment[]
  bookingConfirmation BookingConfirmation?
}

model BookingItem {
  id          String   @id @default(uuid())
  tenantId    String
  bookingId   String
  type        String
  referenceId String
  price       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(uuid())
  amount    Float
  currency  String
  status    String
  tenantId  String
  bookingId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  message   String
  status    String?
  tenantId  String
  userId    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

model Review {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String
  hotelId       String?
  destinationId String?
  rating        Int
  comment       String
  aiAnalysis    String?  @map("ai_analysis")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel       Hotel?       @relation(fields: [hotelId], references: [id])
  destination Destination? @relation(fields: [destinationId], references: [id])

  @@index([tenantId])
  @@map("reviews")
}

model BackgroundJob {
  id          String    @id @default(uuid())
  jobId       String    @unique // BullMQ job ID
  queueName   String // booking-queue, email-queue, etc.
  jobName     String // process-confirmation, send-email, etc.
  data        Json // Të dhënat e job-it
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  error       String?
  result      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  tenantId  String?
  userId    String?
  bookingId String?

  @@index([jobId])
  @@index([queueName])
  @@index([status])
  @@index([tenantId])
}

model BookingConfirmation {
  id                 String    @id @default(uuid())
  bookingId          String    @unique
  tenantId           String
  confirmedAt        DateTime
  confirmationNumber String    @unique
  sentViaEmail       Boolean   @default(false)
  emailSentAt        DateTime?
  smsSentAt          DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([confirmationNumber])
}

model EmailLog {
  id         String      @id @default(uuid())
  to         String
  subject    String
  content    String
  template   String?
  status     EmailStatus @default(PENDING)
  error      String?
  sentAt     DateTime?
  retryCount Int         @default(0)
  tenantId   String
  userId     String?
  createdAt  DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tenantId])
  @@index([createdAt])
}

model WebhookEvent {
  id          String        @id @default(uuid())
  eventType   String // booking.confirmed, payment.received, etc.
  payload     Json
  status      WebhookStatus @default(PENDING)
  response    String?
  retryCount  Int           @default(0)
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  tenantId    String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([eventType])
  @@index([createdAt])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRY
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TravelPackage {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  price         Float
  duration      Int
  imageUrl      String?
  destinationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  hotels  Hotel[]
  flights Flight[]

  @@index([tenantId])
  @@index([destinationId])
}

model Airline {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String // p.sh., "LH" për Lufthansa, "TK" për Turkish Airlines
  country   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Airport {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String // IATA code, p.sh., "PRN", "TIA", "JFK"
  city      String
  country   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Activity {
  id            String   @id @default(uuid())
  tenantId      String
  destinationId String
  name          String
  description   String
  price         Float
  duration      String // p.sh., "2 hours", "Full day"
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([destinationId])
}

model AiChat {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  prompt    String
  response  String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}


model TenantSettings {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  theme     String   @default("light")
  language  String   @default("en")
  currency  String   @default("EUR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Wishlist {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String
  destinationId String
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([tenantId])
  @@index([userId])
}

model Coupon {
  id        String   @id @default(uuid())
  tenantId  String
  code      String // p.sh., "VARA2026"
  discount  Float // Përqindja e zbritjes, p.sh., 15.0 për 15%
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}
